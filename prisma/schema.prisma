// Fubrio — Complete CMS schema (Supabase / PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  role          String   @default("CONTRIBUTOR") // SUPER_ADMIN | ADMIN | EDITOR | CONTRIBUTOR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  sessions      Session[]
  inquiries     Inquiry[]
  posts         BlogPost[]
  projects      Project[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String  @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// CONTENT — Projects / Showcase
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  icon        String?
  type        String   @default("project") // project | product | service | post | partner | sponsor
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]
  products    Product[]
  posts       BlogPost[]
  services    Service[]
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String?
  content      String?
  coverImage   String?
  tags         Tag[]
  authorId     String?
  author       User?   @relation(fields: [authorId], references: [id])
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  status       String  @default("DRAFT") // DRAFT | PUBLISHED
  featured     Boolean @default(false)
  publishedAt  DateTime?
  readTime     Int     @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  projects  Project[]
  products  Product[]
  posts     BlogPost[]
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDesc       String?
  fullDesc        String?
  thumbnail       String?
  coverImage      String?
  gallery         String   @default("[]") // JSON array of strings
  videos          String   @default("[]")
  demoUrl         String?
  githubUrl       String?
  downloadUrl     String?
  purchaseUrl     String?
  technologies    String   @default("[]") // JSON array
  status          String   @default("DRAFT") // DRAFT | LIVE | MAINTENANCE | ARCHIVED
  visibility      String   @default("PUBLIC") // PUBLIC | PRIVATE
  featured        Boolean  @default(false)
  launchDate      DateTime?
  lastUpdated     DateTime @updatedAt
  publishedAt     DateTime?
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id])
  contributors    String   @default("[]") // JSON array of {name, role, avatar}
  client          String?
  meta            String   @default("{}") // JSON custom metadata
  seoTitle        String?
  seoDesc         String?
  ogImage         String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            Tag[]
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDesc       String?
  fullDesc        String?
  thumbnail       String?
  coverImage      String?
  gallery         String   @default("[]")
  features        String   @default("[]") // JSON array of strings
  demoUrl         String?
  documentation   String?
  version         String?
  changelog       String?
  requirements    String?
  price           Float    @default(0)
  currency        String   @default("USD")
  isFree          Boolean  @default(false)
  status          String   @default("DRAFT")
  featured        Boolean  @default(false)
  technologies    String   @default("[]")
  tags            Tag[]
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  publishedAt     DateTime?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title        String
  slug         String   @unique
  shortDesc    String?
  fullDesc     String?
  icon         String?
  image        String?
  features     String   @default("[]")
  pricingType  String   @default("custom") // fixed | hourly | custom
  price        Float?
  currency     String   @default("USD")
  ctaText      String   @default("Get a quote")
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  featured     Boolean  @default(false)
  status       String   @default("PUBLISHED")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  tier         String   @default("BRONZE") // PLATINUM | GOLD | SILVER | BRONZE
  industry    String?
  contactName String?
  contactEmail String?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  socials     String   @default("{}") // JSON {twitter, github, ...}
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  type        String   @default("TECHNOLOGY") // TECHNOLOGY | COMMUNITY | DEVELOPMENT | MEDIA | BRAND | STRATEGIC
  socials     String   @default("{}")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  avatar    String?
  content   String
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  location    String?
  url         String?
  type        String   @default("MEETUP") // MEETUP | WEBINAR | WORKSHOP | CONFERENCE
  status      String   @default("UPCOMING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Metric {
  id    String @id @default(cuid())
  key   String @unique
  label String
  value String
  unit  String?
  icon  String?
  order Int    @default(0)
}

model Inquiry {
  id          String   @id @default(cuid())
  reference   String   @unique
  name        String
  email       String
  company     String?
  inquiryType String   @default("GENERAL") // GENERAL | PROJECT | PARTNERSHIP | SPONSORSHIP | SUPPORT | COLLABORATION | CAREERS | OTHER
  budget      String?
  message     String
  attachment  String?
  status      String   @default("NEW") // NEW | IN_PROGRESS | REPLIED | RESOLVED | ARCHIVED
  internalNotes String?
  assignedTo  String?
  assignee    User?    @relation(fields: [assignedTo], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   // image | video | document
  mime      String?
  size      Int?
  alt       String?
  caption   String?
  tags      String   @default("[]")
  folder    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  description String?
  sections    PageSection[]
  seoTitle    String?
  seoDesc     String?
  ogImage     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageSection {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type       String   // hero | text | image | gallery | video | project_showcase | product_showcase | sponsor_grid | partner_grid | logo_marquee | services_grid | feature_cards | stats | testimonials | pricing | faq | timeline | team | blog_list | cta | contact_form | newsletter | custom_html | embed | announcement | comparison | events | community_links
  content    String   @default("{}") // JSON
  config      String   @default("{}") // JSON
  visibility  String   @default("PUBLIC") // PUBLIC | HIDDEN
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReusableBlock {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String
  content   String   @default("{}")
  config     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  parentId  String?
  parent    NavItem? @relation("NavItemHierarchy", fields: [parentId], references: [id])
  children  NavItem[] @relation("NavItemHierarchy")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  icon      String?
}

model FooterColumn {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  links     String   @default("[]") // JSON [{label, href}]
  visible   Boolean  @default(true)
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
}

model ShortLink {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  type        String   @default("file") // file | redirect | text | embed
  targetUrl   String?  // for redirect
  filePath    String?  // local storage path for uploaded file
  fileName    String?  // original uploaded file name
  fileMime    String?
  fileSize    Int?
  textContent String?  // for text type
  embedHtml   String?  // for embed type
  password    String?  // optional access password
  expiresAt   DateTime?
  visits      Int      @default(0)
  createdBy   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
